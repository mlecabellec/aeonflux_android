<?xml version="1.0" encoding="utf-8"?>
<!--
  [CS-0010] [CS-0020] Layout for ItemViewActivity with High-Contrast Action Button Group.
  Reference: FR-20260809-001 / TSK-20260809-001.3
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_item_author_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_item_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="16sp" />

        <!-- [TSK-20260809-001.3] Action Card Button Group below article content -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="ARTICLE ACTIONS"
                    android:textColor="#3B82F6"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_open_embedded_webview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#3B82F6"
                    android:padding="12dp"
                    android:text="🌐 View in Embedded WebView"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btn_open_private_webview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#0F172A"
                    android:padding="12dp"
                    android:text="🔒 View in Private WebView"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btn_open_external_browser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#0EA5E9"
                    android:padding="12dp"
                    android:text="↗️ Open in Web Browser"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btn_toggle_read_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#10B981"
                    android:padding="12dp"
                    android:text="✓ Mark as Read"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btn_copy_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#64748B"
                    android:padding="12dp"
                    android:text="📋 Copy URL to Clipboard"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
