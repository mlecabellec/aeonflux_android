<?xml version="1.0" encoding="utf-8"?>
<!--
  [CS-0010] [CS-0020] Layout for AboutActivity embedded WebView viewer.
  Reference: FR-20260809-003 / TSK-20260809-003.1
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <ProgressBar
        android:id="@+id/progress_about_loading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_alignParentTop="true"
        android:indeterminate="true"
        android:visibility="gone" />

    <WebView
        android:id="@+id/webview_about"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/progress_about_loading" />

</RelativeLayout>
